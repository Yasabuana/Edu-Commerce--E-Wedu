{
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php@0.6.2"
    }
  ],
  "functions": {
    "api/index.php": {
      "includeFiles": "{app,bootstrap,config,database,public,resources,routes,storage}/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}